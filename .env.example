# ---------- Settings storage (Upstash Redis) ----------
# Settings saved on the Settings page are stored in Redis and take priority over the variables below.
# Vercel -> Storage -> Upstash Redis -> Connect Project creates these automatically (the prefix is whatever you
# chose when connecting, e.g. STORAGE_KV_REST_API_URL). Any of these name pairs is detected, server-side only:
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
#   <PREFIX>KV_REST_API_URL / <PREFIX>KV_REST_API_TOKEN
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: encrypts the HiveOS token stored in Redis (min. 32 chars, npm run generate-secret).
# If unset, the Redis token is used as the encryption key.
SETTINGS_SECRET=

# ---------- HiveOS (https://api2.hiveos.farm/api/v2) ----------
# Account -> Settings -> Personal API tokens. A read-only token is enough.
HIVEOS_API_TOKEN=
# Numeric IDs: they appear in the farm URL (/farms/<FARM_ID>) and worker URL (/workers/<WORKER_ID>).
HIVEOS_FARM_ID=
HIVEOS_WORKER_ID=
# Unit of the per-GPU "hash" values HiveOS reports: hs | khs | mhs | ghs (default khs)
HIVEOS_HASHRATE_UNIT=

# ---------- Kryptex Pool (https://pool.kryptex.com/api) ----------
# The Kryptex pool API is public and has NO API key/secret: it is keyed by your mining wallet address.
KRYPTEX_WALLET_ADDRESS=
# Pool slug of the coin (PEARL = prl)
KRYPTEX_COIN=prl
# Optional: only count this worker name for the pool-side hashrate
KRYPTEX_WORKER_NAME=

# ---------- CoinGecko ----------
# Verified API id for PEARL: pearl-2  (see README to double-check)
COINGECKO_COIN_ID=pearl-2
# Optional. Free "Demo" key works with the default plan; use "pro" only with a paid key.
COINGECKO_API_KEY=
COINGECKO_API_PLAN=demo

# ---------- Mining economics / display ----------
ELECTRICITY_PRICE_RON_KWH=
# RON | EUR | USD (default RON)
DISPLAY_CURRENCY=RON

# ---------- Optional tuning ----------
REFRESH_INTERVAL_SECONDS=30
EXPECTED_GPU_COUNT=10
GPU_TEMP_WARN_C=70
GPU_TEMP_CRIT_C=80
GPU_MEM_TEMP_WARN_C=90
GPU_MEM_TEMP_CRIT_C=100

# Development only (ignored in production): show sample data without any API credentials.
USE_MOCK_DATA=false
